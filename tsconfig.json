{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "packaging/**/*.ts"],
  "exclude": [
    "**/fixtures/**",
    "**/test/repos/**",
    "**/.gitatlas/**",
    "**/node_modules/**"
  ]
}
