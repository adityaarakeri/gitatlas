{
  "name": "gitatlas",
  "version": "0.10.0",
  "description": "Multi-repo architecture maps you can zoom into. C4-from-code, open source.",
  "license": "MIT",
  "author": "Aditya Arakeri",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaarakeri/gitatlas.git"
  },
  "homepage": "https://github.com/adityaarakeri/gitatlas#readme",
  "bugs": {
    "url": "https://github.com/adityaarakeri/gitatlas/issues"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "extract": "node bin/gitatlas.js extract",
    "check": "node bin/gitatlas.js check",
    "brief": "node bin/gitatlas.js brief",
    "mcp": "node bin/gitatlas.js mcp",
    "scope": "node bin/gitatlas.js scope",
    "site": "node bin/gitatlas.js site",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"packages/**/*.ts\" bin/gitatlas.js --max-warnings=0",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "code-graph",
    "architecture",
    "visualization",
    "multi-repo",
    "c4-model",
    "static-analysis",
    "knowledge-graph",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-force": "^3.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.6.0",
    "web-tree-sitter": "0.25.10"
  },
  "bin": {
    "gitatlas": "bin/gitatlas.js"
  }
}
